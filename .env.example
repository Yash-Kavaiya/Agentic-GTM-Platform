# Copy to .env and fill in. .env is gitignored and must never be committed.
# Get a key from https://brightdata.com  (or run `bdata login` for OAuth instead)
BRIGHTDATA_API_KEY=

# Optional: where Publish sends the campaign payload
BELLWETHER_WEBHOOK_URL=
BELLWETHER_SLACK_WEBHOOK_URL=

# Set to 1 to run the full pipeline against fixtures without spending credit
BELLWETHER_DRY_RUN=0
